# Postgres connection strings (Neon free tier) — `neon link`/`neon env pull` writes both.
# DATABASE_URL is pooled (PgBouncer), for the app's normal query traffic.
# DATABASE_URL_UNPOOLED is direct — Payload uses this one (see src/payload.config.ts)
# since its single connection pool also runs internal schema push/migrate, which
# can break over a pooled/transaction-mode connection.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Random string used to sign Payload's auth tokens — generate with `openssl rand -hex 32`
PAYLOAD_SECRET=

# The site's own URL (used by Payload for absolute links/previews)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Cloudflare R2 (S3-compatible) bucket for uploaded media
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=auto

# R2 bucket's public base URL (public dev URL or a mapped custom domain) —
# used both to build public file URLs and to derive the next/image remotePattern hostname
R2_PUBLIC_URL=
